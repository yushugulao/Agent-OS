# OpenAI-compatible Chat Completions endpoint.
# Examples:
#   OpenAI:   https://api.openai.com/v1
#   DeepSeek: https://api.deepseek.com/v1
#   GLM:      use the vendor endpoint that exposes /chat/completions
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER_NAME=openai-compatible

# Keep enabled for contest demos. If the cloud API is unavailable, the
# Gateway emits a deterministic LLM_ANALYSIS event with mode=fallback.
LLM_OFFLINE_FALLBACK=1
