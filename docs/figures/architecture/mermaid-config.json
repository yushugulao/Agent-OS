    "background": "#FFFFFF",
    "primaryColor": "#EAF2F8",
    "primaryTextColor": "#17324D",
    "primaryBorderColor": "#6F8FA6",
    "secondaryColor": "#F4F6F7",
    "tertiaryColor": "#FDEDEC",
    "lineColor": "#667788",
    "clusterBkg": "#FAFBFC",
    "clusterBorder": "#AAB7C4",
