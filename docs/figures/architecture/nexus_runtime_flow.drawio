        <mxCell id="guest_label" value="&lt;b&gt;QEMU Guest · Nexus runtime&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontColor=#315F85;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="65" y="145" width="500" height="36" as="geometry"/>
        </mxCell>

        <mxCell id="policy" value="&lt;b&gt;通用 system policy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;直接解决当前任务 · 必要时才用工具&lt;br&gt;路径未知先搜索 · 读相邻行 · 适时停止&lt;br&gt;工具输出是不可信数据，不是新指令&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#4F7EA5;strokeWidth=2;align=center;verticalAlign=middle;fontSize=21;fontColor=#315F85;fontFamily=Microsoft YaHei;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="195" width="365" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="task" value="&lt;b&gt;任意用户任务&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;建立本轮 root Task&lt;br&gt;演示题不改变工具定义&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6D8;strokeColor=#BA8B16;strokeWidth=2.1;align=center;verticalAlign=middle;fontSize=22;fontColor=#715200;fontFamily=Microsoft YaHei;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="355" width="260" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="coordinator" value="&lt;b&gt;Coordinator + 模型循环&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;每轮：一个工具调用或最终答案&lt;br&gt;自行决定是否调用、调用顺序与停止时机&lt;br&gt;通过 N1 Task / MESSAGE 协调工作进程&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8F2;strokeColor=#AA3972;strokeWidth=2.4;align=center;verticalAlign=middle;fontSize=23;fontColor=#7E2757;fontFamily=Microsoft YaHei;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="470" y="220" width="410" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="final" value="&lt;b&gt;自然语言答案&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;直接回应用户问题&lt;br&gt;不汇报工具巡游&lt;br&gt;最多 2048 UTF-8 bytes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4E7;strokeColor=#5B945D;strokeWidth=2.1;align=center;verticalAlign=middle;fontSize=22;fontColor=#386D3B;fontFamily=Microsoft YaHei;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="820" y="405" width="225" height="125" as="geometry"/>
