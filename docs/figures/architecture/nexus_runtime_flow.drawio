  <diagram id="nexus-runtime-flow" name="AgentOS Nexus Context-led runtime">
    <mxGraphModel dx="1760" dy="1240" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1240" math="0" shadow="0" adaptiveColors="auto" background="none">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="AgentOS Nexus：Context 主导的跨轮路径" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=34;fontStyle=1;fontColor=#173F5F;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="250" y="15" width="1260" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Guest Context 决定历史  |  Metadata Catalog 选择文件  |  Task Channel 委派  |  Host 仅传 manifest 与版本字节" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=19;fontColor=#526A7A;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="140" y="70" width="1480" height="38" as="geometry"/>
        </mxCell>

        <mxCell id="guest_boundary" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBFDFE;strokeColor=#4F7EA5;strokeWidth=2.2;dashed=1;dashPattern=8 6;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="35" y="125" width="1080" height="850" as="geometry"/>
        </mxCell>
        <mxCell id="guest_label" value="&lt;b&gt;QEMU Guest · Nexus runtime&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontColor=#315F85;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="62" y="142" width="520" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="host_boundary" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDFCFF;strokeColor=#7765A0;strokeWidth=2.2;dashed=1;dashPattern=8 6;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1140" y="125" width="585" height="850" as="geometry"/>
        </mxCell>
        <mxCell id="host_label" value="&lt;b&gt;Host relay&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontColor=#5A4B81;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="1168" y="142" width="420" height="36" as="geometry"/>
        </mxCell>

        <mxCell id="user_task" value="&lt;b&gt;任意用户任务&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;建立本轮 root Task&lt;br&gt;后续问题可引用先前成功轮次&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6D8;strokeColor=#BA8B16;strokeWidth=2.1;align=center;verticalAlign=middle;fontSize=22;fontColor=#715200;fontFamily=Microsoft YaHei;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="215" width="255" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="relay_agent" value="&lt;b&gt;Guest Relay Agent + 模型循环&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;通用 system policy · 每次一个工具或最终答案&lt;br&gt;从自己的 Context 重建跨轮消息&lt;br&gt;自行决定调用、继续与停止&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8F2;strokeColor=#AA3972;strokeWidth=2.4;align=center;verticalAlign=middle;fontSize=23;fontColor=#7E2757;fontFamily=Microsoft YaHei;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="390" y="195" width="400" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="final_answer" value="&lt;b&gt;自然语言答案&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;直接回应用户问题&lt;br&gt;成功后进入 FINAL 节点&lt;br&gt;最多 2048 UTF-8 bytes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4E7;strokeColor=#5B945D;strokeWidth=2.1;align=center;verticalAlign=middle;fontSize=22;fontColor=#386D3B;fontFamily=Microsoft YaHei;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="850" y="210" width="225" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="context_path" value="&lt;b&gt;Relay Agent 的 Context active path&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;短节点：USER → 已结算 TOOL* → 成功 FINAL&lt;br&gt;映射页 direct active query，必要时 syscall 回退&lt;br&gt;失败 / 取消：回滚本轮　　/reset：清空路径和缓存&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4F2;strokeColor=#278978;strokeWidth=2.5;align=center;verticalAlign=middle;fontSize=23;fontColor=#17685C;fontFamily=Microsoft YaHei;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="405" width="700" height="165" as="geometry"/>
        </mxCell>
        <mxCell id="user_cache" value="&lt;b&gt;第 7 页 · 4 KiB 用户缓存&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;最多两对完整 USER / FINAL&lt;br&gt;只保留可完整容纳的最新后缀&lt;br&gt;只采纳 active path 匹配项&lt;br&gt;缓存不是历史权威&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6A31B;strokeWidth=2.1;align=center;verticalAlign=middle;fontSize=20;fontColor=#715200;fontFamily=Microsoft YaHei;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="815" y="415" width="260" height="145" as="geometry"/>
        </mxCell>

        <mxCell id="public_tools" value="&lt;b&gt;三个公开的只读工具&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;&lt;b&gt;search_files&lt;/b&gt;　候选内路径 / 正文搜索&lt;br&gt;&lt;b&gt;read_file&lt;/b&gt;　版本绑定的分段读取&lt;br&gt;&lt;b&gt;inspect_system&lt;/b&gt;　Guest 状态观察&lt;br&gt;工具与演示题目无关&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAF7;strokeColor=#82609A;strokeWidth=2.1;align=center;verticalAlign=middle;fontSize=21;fontColor=#624273;fontFamily=Microsoft YaHei;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="65" y="675" width="285" height="215" as="geometry"/>
        </mxCell>
        <mxCell id="workspace_catalog" value="&lt;b&gt;Guest Metadata Catalog 窗口&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;1 control + 最多 32 个真实 stub inode&lt;br&gt;4 × 8 Live Query 选择并复核候选&lt;br&gt;完整字段留在有界 runtime arena&lt;br&gt;control Typed Watch UPDATE 使旧 generation 失效&lt;br&gt;有界目录窗口，不是全文索引&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F4EE;strokeColor=#3F8B6B;strokeWidth=2.2;align=center;verticalAlign=middle;fontSize=20;fontColor=#28664F;fontFamily=Microsoft YaHei;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="380" y="650" width="335" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="task_workers" value="&lt;b&gt;Coordinator + Research / System&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;原生 delegated Task Channel&lt;br&gt;SQ / pending → claim → complete / ACK&lt;br&gt;controller：sys568 REQUEST_CANCEL + 精确绑定&lt;br&gt;owner：唯一 CQE → Contract RECLAIMED&lt;br&gt;56 B descriptor；大输入 / 结果使用 Guest artifact&lt;br&gt;Research / System 不是独立子模型&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#4F7EA5;strokeWidth=2.2;align=center;verticalAlign=middle;fontSize=18;fontColor=#315F85;fontFamily=Microsoft YaHei;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="750" y="650" width="335" height="260" as="geometry"/>
        </mxCell>

        <mxCell id="provider" value="&lt;b&gt;Provider / Replay&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;接收 Guest 构造的同一消息与真实 TOOL 投影&lt;br&gt;在线模式：thinking enabled&lt;br&gt;固定 replay：只替换模型回复来源&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EEFB;strokeColor=#7562A5;strokeWidth=2.2;align=center;verticalAlign=middle;fontSize=22;fontColor=#514278;fontFamily=Microsoft YaHei;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1180" y="205" width="500" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="workspace" value="&lt;b&gt;Host workspace broker · 字节传输边界&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;显式配置并固定句柄的 workspace root&lt;br&gt;manifest(cursor, ≤32) + generation&lt;br&gt;仅扫描 Guest 已选 object / path / revision 候选&lt;br&gt;按 revision 返回指定 UTF-8 分段字节&lt;br&gt;拒绝路径逃逸；不选文件、不执行 child Task&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1E5;strokeColor=#C5762B;strokeWidth=2.2;align=center;verticalAlign=middle;fontSize=21;fontColor=#8A4C17;fontFamily=Microsoft YaHei;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1180" y="420" width="500" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="host_validation" value="&lt;b&gt;Task ledger + 非正文关联&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;原始 workspace event / telemetry：绑定、游标与字节数&lt;br&gt;controller 可接收 Guest 结算后的 TOOL_EVENT 投影&lt;br&gt;Host ledger 只暂存该 Guest 投影并核对关联&lt;br&gt;不私建、补写或替换 Provider 历史&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2FB;strokeColor=#5673A8;strokeWidth=2.2;align=center;verticalAlign=middle;fontSize=22;fontColor=#3A5488;fontFamily=Microsoft YaHei;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1180" y="700" width="500" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="modes" value="在线 Provider 与固定 Replay：相同 Guest 消息路径，不同回复来源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F7FB;strokeColor=#9A8CB7;strokeWidth=1.7;dashed=1;dashPattern=5 4;align=center;verticalAlign=middle;fontSize=17;fontColor=#645783;fontFamily=Microsoft YaHei;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1170" y="905" width="520" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="kernel" value="&lt;b&gt;AgentOS kernel runtime&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px&quot;&gt;Agent identity + TASK_ACCEPT / TASK route　|　delegated Task Channel SQ/CQ + claim/complete/cancel　|　Metadata Catalog + Typed Watch&lt;br&gt;Context active path + 4 KiB user page　|　Workflow lifecycle + Credit Domain + EEVDF　|　运行记录环 + Workflow Fence&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF5F9;strokeColor=#4E7798;strokeWidth=2.3;align=center;verticalAlign=middle;fontSize=24;fontColor=#315A78;fontFamily=Microsoft YaHei;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="1045" width="1600" height="135" as="geometry"/>
        </mxCell>

        <mxCell id="e_user_relay" value="USER_MESSAGE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2.1;strokeColor=#BA8B16;endArrow=blockThin;endFill=1;fontSize=15;fontColor=#715200;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="user_task" target="relay_agent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_relay_provider" value="MODEL_REQUEST / RESPONSE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2.2;strokeColor=#7562A5;startArrow=blockThin;startFill=1;endArrow=blockThin;endFill=1;fontSize=15;fontColor=#514278;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="relay_agent" target="provider"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="955" y="175"/><mxPoint x="1160" y="175"/></Array></mxGeometry></mxCell>
        <mxCell id="e_relay_final" value="成功回答" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2.1;strokeColor=#5B945D;endArrow=blockThin;endFill=1;fontSize=15;fontColor=#386D3B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="relay_agent" target="final_answer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_relay_context" value="写 USER / 读取 active path" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2.2;strokeColor=#278978;startArrow=blockThin;startFill=1;endArrow=blockThin;endFill=1;fontSize=15;fontColor=#17685C;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="relay_agent" target="context_path"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_final_context" value="成功 FINAL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#5B945D;endArrow=blockThin;endFill=1;fontSize=15;fontColor=#386D3B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="final_answer" target="context_path"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1090" y="365"/><mxPoint x="790" y="365"/></Array></mxGeometry></mxCell>
        <mxCell id="e_context_cache" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#D6A31B;startArrow=blockThin;startFill=1;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="context_path" target="user_cache"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_relay_tools" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.9;strokeColor=#AA3972;endArrow=blockThin;endFill=1;fontSize=15;fontColor=#7E2757;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="relay_agent" target="public_tools"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="355" y="365"/><mxPoint x="55" y="365"/><mxPoint x="55" y="640"/><mxPoint x="300" y="640"/></Array></mxGeometry></mxCell>
