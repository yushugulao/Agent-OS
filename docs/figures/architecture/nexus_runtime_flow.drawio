        <mxCell id="title" value="AgentOS Nexus 自主任务与证据结算" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=34;fontStyle=1;fontColor=#234E70;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="1260" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="任意用户任务  |  模型自主决定是否、何时、以何种顺序调用工具  |  每轮只返回一个工具调用或最终答案" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=19;fontColor=#526D82;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="170" y="74" width="1420" height="38" as="geometry"/>
        </mxCell>

        <mxCell id="runtime_boundary" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFEFF;strokeColor=#6C91B8;strokeWidth=2.2;dashed=1;dashPattern=8 6;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="135" width="1120" height="760" as="geometry"/>
        </mxCell>
        <mxCell id="runtime_label" value="&lt;b&gt;Guest Nexus runtime&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontColor=#315F91;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="68" y="150" width="420" height="36" as="geometry"/>
        </mxCell>

        <mxCell id="goal" value="&lt;b&gt;用户任务&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;任意非空目标&lt;br&gt;建立本轮 root Task&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7D9;strokeColor=#C49A24;strokeWidth=2.2;align=center;verticalAlign=middle;fontSize=22;fontColor=#735600;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="80" y="220" width="220" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="decision" value="&lt;b&gt;模型自主决策&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;直接回答，或自行选择工具&lt;br&gt;允许跳过、重复、重排&lt;br&gt;16 decisions / 32 retries&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8F4;strokeColor=#B72B76;strokeWidth=2.4;align=center;verticalAlign=middle;fontSize=23;fontColor=#8C1F5C;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="355" y="200" width="340" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="direct_final" value="&lt;b&gt;最终答案&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;Guest 公开正文&lt;br&gt;最多 2048 UTF-8 bytes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F4E2;strokeColor=#6B9E50;strokeWidth=2.2;align=center;verticalAlign=middle;fontSize=22;fontColor=#467529;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="850" y="220" width="260" height="105" as="geometry"/>
        </mxCell>

