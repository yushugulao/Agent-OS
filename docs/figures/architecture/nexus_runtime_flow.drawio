  <diagram id="nexus-runtime-flow" name="AgentOS Nexus autonomous runtime">
    <mxGraphModel dx="1760" dy="1160" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1160" math="0" shadow="0" adaptiveColors="auto" background="none">
      <root>
        <mxCell id="0"/>
