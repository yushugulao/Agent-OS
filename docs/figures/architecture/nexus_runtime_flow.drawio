          <mxGeometry x="75" y="400" width="1040" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="tool_label" value="&lt;b&gt;五个公开工具（每轮最多一个 call）&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=21;fontColor=#315F91;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="95" y="410" width="610" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="source_search" value="&lt;b&gt;source_search&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;已验证源码快照&lt;br&gt;发现候选位置&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8F8;strokeColor=#8D66A0;strokeWidth=1.9;align=center;verticalAlign=middle;fontSize=18;fontColor=#684078;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="95" y="465" width="185" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="source_read" value="&lt;b&gt;source_read&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;精确行读取&lt;br&gt;Host-attested citation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEE4F6;strokeColor=#8D66A0;strokeWidth=1.9;align=center;verticalAlign=middle;fontSize=18;fontColor=#684078;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="300" y="465" width="185" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="inspect_runtime" value="&lt;b&gt;inspect_runtime&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;当前 Guest boot&lt;br&gt;未 attested 的观察&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F1FF;strokeColor=#4F82B6;strokeWidth=1.9;align=center;verticalAlign=middle;fontSize=18;fontColor=#285E91;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="505" y="465" width="185" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="draft_report" value="&lt;b&gt;draft_report&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;原样保存&lt;br&gt;模型撰写的报告&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E1;strokeColor=#CC7F29;strokeWidth=1.9;align=center;verticalAlign=middle;fontSize=18;fontColor=#995713;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="710" y="465" width="185" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="read_artifact" value="&lt;b&gt;read_artifact&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;只回读本轮&lt;br&gt;最新报告句柄&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF8F3;strokeColor=#349778;strokeWidth=1.9;align=center;verticalAlign=middle;fontSize=18;fontColor=#176E55;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="915" y="465" width="180" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="broker" value="&lt;b&gt;Task broker + specialist worker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;仅在模型选择前四类工具时建立 child Task&lt;br&gt;N1 / MESSAGE 状态转换，重放计算 worker payload，核对 size + SHA-256&lt;br&gt;临时 runtime/source 结果不向历史暴露 handle&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF8F3;strokeColor=#23886D;strokeWidth=2.3;align=center;verticalAlign=middle;fontSize=22;fontColor=#12634F;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="85" y="660" width="510" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="report_readback" value="&lt;b&gt;报告完整性回读&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;draft_report 生成本轮唯一持久句柄&lt;br&gt;read_artifact 核对 turn / owner / kind / digest&lt;br&gt;无外部发布，terminal 前清理&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E7;strokeColor=#C57A2B;strokeWidth=2.3;align=center;verticalAlign=middle;fontSize=22;fontColor=#895019;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="625" y="660" width="485" height="155" as="geometry"/>
        </mxCell>

