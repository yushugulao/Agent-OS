        <mxCell id="tools_label" value="&lt;b&gt;三个公开的只读工具&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=21;fontColor=#315F85;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="75" y="495" width="390" height="32" as="geometry"/>
        </mxCell>
