          <mxGeometry x="1190" y="135" width="530" height="760" as="geometry"/>
        </mxCell>
        <mxCell id="host_label" value="&lt;b&gt;Host relay + proof settlement&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontColor=#5C5183;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="1215" y="150" width="460" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="provider" value="&lt;b&gt;Provider / Replay&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;generation max_tokens = 114514&lt;br&gt;DeepSeek V4: thinking enabled&lt;br&gt;reasoning_effort = max&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EEFF;strokeColor=#7562A5;strokeWidth=2.2;align=center;verticalAlign=middle;fontSize=22;fontColor=#514278;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="1230" y="220" width="450" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="reasoning" value="&lt;b&gt;provider-private reasoning_content&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;工具轮之间向 provider 原样回传&lt;br&gt;不进入 Guest / controller / telemetry&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9F7FF;strokeColor=#9D91C0;strokeWidth=1.8;dashed=1;dashPattern=5 4;align=center;verticalAlign=middle;fontSize=19;fontColor=#645989;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="1230" y="390" width="450" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="ledger" value="&lt;b&gt;Host Task ledger&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;root / child DAG，turn / lifecycle&lt;br&gt;内核 PID / agent / control identity&lt;br&gt;状态迁移、artifact / evidence / terminal roots&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2FF;strokeColor=#5873AC;strokeWidth=2.1;align=center;verticalAlign=middle;fontSize=21;fontColor=#3C548B;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="1230" y="545" width="450" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="attestation" value="&lt;b&gt;Source attestation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;QEMU 启动前验证不可变 corpus&lt;br&gt;revision + manifest + exact lines + citation&lt;br&gt;重建 chunk / artifact / projection digest&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EAFA;strokeColor=#8B63A1;strokeWidth=2.1;align=center;verticalAlign=middle;fontSize=21;fontColor=#684079;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
          <mxGeometry x="1230" y="705" width="450" height="135" as="geometry"/>
        </mxCell>

        <mxCell id="kernel" value="&lt;b&gt;AgentOS kernel invariants&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot;&gt;lifecycle generation  |  Agent identity + capability  |  Context + provenance  |  MESSAGE / wait / LLM_DONE&lt;br&gt;Workflow Credit Domain + EEVDF  |  generation-safe artifact namespace  |  Evidence Ring + Workflow Fence&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F8FC;strokeColor=#527DA6;strokeWidth=2.2;align=center;verticalAlign=middle;fontSize=22;fontColor=#315F85;fontFamily=Microsoft YaHei;" vertex="1" parent="1">
