flowchart TB
  subgraph early["Early Design"]
    direction LR
    e1["Recursive Scan"] --> e2["Persistent Store"] --> e3["Substring Watch"]
  end

  subgraph current["Current Design"]
    direction TB
    subgraph ctop["Discovery Path"]
      direction LR
      c1["Explicit Metadata"] --> c2["Volatile Catalog"] --> c3["Typed Query"]
    end
    subgraph cbottom["Notification Path"]
      direction RL
      n1["Typed Watch"] --> n2["ENTER / UPDATE / LEAVE"]
      g1["Generation Gap"] --> g2["Full Snapshot"] --> g3["ACK"]
    end
    ctop --> cbottom
  end

  e3 -. "Redesign" .-> c1

  classDef earlyStep fill:#F4F6F7,stroke:#8996A3,color:#263746,stroke-width:1.5px;
  classDef risk fill:#FDEDEC,stroke:#C65B5B,color:#6E2020,stroke-width:2px;
  classDef currentStep fill:#EAF2F8,stroke:#5E8FAF,color:#17324D,stroke-width:1.8px;
  class e1,e2 earlyStep;
  class e3 risk;
  class c1,c2,c3,n1,n2,g1,g2,g3 currentStep;
  style early fill:#FBFCFD,stroke:#AAB7C4,stroke-width:1.5px
  style current fill:#F7FBFE,stroke:#7FA8C2,stroke-width:1.5px
  style ctop fill:#FFFFFF,stroke:#B8C8D4,stroke-width:1px,stroke-dasharray:4 3
  style cbottom fill:#FFFFFF,stroke:#B8C8D4,stroke-width:1px,stroke-dasharray:4 3
